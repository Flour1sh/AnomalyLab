*.code-workspace

# Python caches and local environments.
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets and machine-specific tooling state.
.env
.env.*
!.env.example
.ual-build
.DS_Store
Thumbs.db

# Blender autosaves; keep the editable .blend sources.
*.blend1
*.blend2
