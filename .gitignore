# Unreal-generated files (also applies to project plugins).
Binaries/
Intermediate/
DerivedDataCache/
Saved/

# Packaged game output; keep source-controlled Build/ resources if added later.
/Builds/

# Local IDE and generated project files.
.vs/
.idea/
*.sln
*.suo
*.user
*.sdf
*.opensdf
*.VC.db
